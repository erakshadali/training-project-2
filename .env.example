# Copy to .env.local and fill in. .env.local is git-ignored.

# MongoDB connection string (for example from MongoDB Atlas).
# Leave empty in local development to use a temporary in-memory database (data resets on restart).
MONGODB_URI=
MONGODB_DB=rentease

# Secret used to sign login cookies. At least 16 random characters. Required in production.
AUTH_SECRET=

# Optional: creates an admin account the first time the database is seeded.
# Example values for local testing only. Use your own strong password in production.
ADMIN_EMAIL=admin@rentease.local
ADMIN_PASSWORD=ChangeMe-Local-123
